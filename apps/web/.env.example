# Ρυθμίσεις build της PWA. Όλες ψήνονται στο bundle — δεν υπάρχει μυστικό εδώ.
#
#   VITE_OIDC_AUTHORITY=... pnpm dev:web

VITE_API_URL=http://localhost:3000/api

# ─── OIDC (Authentik) ───
# Κενά ⇒ λειτουργία development: καμία σύνδεση, ο ρόλος έρχεται από το
# `VITE_DEV_EMAIL` μέσω του header `x-dev-email`.
VITE_OIDC_AUTHORITY=http://localhost:9010/application/o/trifylli/
VITE_OIDC_CLIENT_ID=trifylli-pwa

# Χρησιμοποιείται μόνο όταν το OIDC είναι απενεργοποιημένο.
VITE_DEV_EMAIL=admin@trifylli.local

# ─── Error tracking (GlitchTip — `docker compose --profile errors up -d glitchtip`) ───
# DSN του project «pwa» στο τοπικό GlitchTip. Κενό = τίποτα. Στο `quasar dev` τα
# extras (tracing, breadcrumbs, logs, «Αναφορά προβλήματος») είναι ανοιχτά.
VITE_SENTRY_DSN=
# Καταγραφή συνεδριών (OpenObserve — `docker compose --profile replay up -d`,
# token από Ingestion → RUM) και analytics (Umami — `--profile analytics`).
# Κενά = ανενεργά.
VITE_OPENOBSERVE_URL=
VITE_OPENOBSERVE_RUM_TOKEN=
VITE_UMAMI_URL=
VITE_UMAMI_WEBSITE_ID=
