# ─── API ───
NODE_ENV=development
PORT=3000
API_PREFIX=api
CORS_ORIGINS=http://localhost:9000

# ─── Database ───
DATABASE_URL=postgresql://trifylli:trifylli@localhost:5432/trifylli?schema=public

# ─── Authentik (OIDC) ───
OIDC_ISSUER=http://localhost:9010/application/o/trifylli/
OIDC_AUDIENCE=trifylli-pwa
# Ο λογαριασμός που γίνεται υπερδιαχειριστής στην πρώτη του σύνδεση.
SUPER_ADMIN_EMAIL=admin@trifylli.local

OIDC_JWKS_URI=http://localhost:9010/application/o/trifylli/jwks/

# Τοπική ανάπτυξη χωρίς Authentik: η συνεδρία δένει με υπαρκτό λογαριασμό της
# βάσης μέσω email (header `x-dev-email` για εναλλαγή ρόλου ανά αίτημα).
# Απορρίπτεται αυτόματα όταν NODE_ENV=production.
# Admin API του Authentik — πρόσκληση/επαναφορά κωδικού από το /accounts.
# Το token του service account `trifylli-api` (το φτιάχνει το blueprint
# trifylli-security.yaml από το TRIFYLLI_API_TOKEN του docker-compose).
AUTHENTIK_API_URL=http://localhost:9010
AUTHENTIK_API_TOKEN=trifylli-dev-api-token
# Πίσω από proxy (0 = κανένας, τοπική ανάπτυξη). Swagger ανοιχτό εκτός production.
TRUST_PROXY_HOPS=0

DEV_AUTH_BYPASS=true
DEV_AUTH_EMAIL=admin@trifylli.local

# ─── Ouchtracker ───
OUCHTRACKER_BASE_URL=
OUCHTRACKER_API_KEY=

# ─── e-SEO (eseo.seo.gr — Keycloak OIDC + REST) ───
# Ρίζα ΧΩΡΙΣ το /api. Στην παραγωγή: https://eseo.seo.gr/app/eseo
ESEO_BASE_URL=
ESEO_REALM=eseo
ESEO_CLIENT_ID=ssoClient
# Offline refresh token (scope=offline_access) — το μόνο μυστικό που κρατάμε.
# Πάρ' το μία φορά με:  node apps/api/scripts/eseo-offline-token.mjs
ESEO_REFRESH_TOKEN=
ESEO_WEBHOOK_SECRET=
ESEO_SYNC_CRON=0 4 * * *
SYNC_ENABLED=true
