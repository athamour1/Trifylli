{
  "name": "trifylli",
  "version": "1.0.0",
  "private": true,
  "description": "Σύστημα διαχείρισης Τοπικού Τμήματος Σ.Ε.Ο.",
  "packageManager": "pnpm@11.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --filter @trifylli/shared build && pnpm -r --parallel dev",
    "dev:api": "pnpm --filter @trifylli/shared build && pnpm --filter @trifylli/api dev",
    "dev:web": "pnpm --filter @trifylli/shared build && pnpm --filter @trifylli/web dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:migrate": "pnpm --filter @trifylli/api prisma:migrate",
    "db:seed": "pnpm --filter @trifylli/api prisma:seed",
    "db:studio": "pnpm --filter @trifylli/api prisma:studio",
    "infra:up": "docker compose up -d postgres redis mailpit authentik-server authentik-worker garage garage-init",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "infra:sso": "./infra/authentik/setup.sh"
  }
}
