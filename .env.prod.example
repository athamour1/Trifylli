# Παραγωγικές ρυθμίσεις Trifylli — αντίγραψε σε .env.prod και συμπλήρωσε.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Το .env.prod ΔΕΝ μπαίνει στο git (βλ. .gitignore). Μην το μοιράζεσαι.

# ─────────────────── ΥΠΟΧΡΕΩΤΙΚΑ μυστικά ───────────────────
# Βάση δεδομένων (χρησιμοποιείται από API και Authentik):
POSTGRES_PASSWORD=            # openssl rand -base64 32
REDIS_PASSWORD=              # openssl rand -base64 32
# Κλειδί κρυπτογράφησης του Authentik:
AUTHENTIK_SECRET_KEY=        # openssl rand -base64 48
# Αποθήκευση αρχείων (Garage S3 — αποδείξεις ταμείου, εικόνες markdown):
GARAGE_RPC_SECRET=           # openssl rand -hex 32
S3_ACCESS_KEY_ID=            # openssl rand -hex 16
S3_SECRET_ACCESS_KEY=        # openssl rand -base64 32

# ─────────────────── Δημόσια URLs (του reverse proxy) ───────────────────
# Αντικατέστησε τα example domains με τα δικά σου. Πρέπει να είναι ΑΚΡΙΒΩΣ ό,τι
# βλέπει ο browser (μέσω του proxy σου με TLS).
#
# Το origin της PWA — για το CORS του API:
CORS_ORIGINS=https://app.trifylli.gr
# Ο OIDC issuer: πρέπει να ταιριάζει ΑΚΡΙΒΩΣ με το `iss` του token του Authentik.
OIDC_ISSUER=https://sso.trifylli.gr/application/o/trifylli/
# Το JWKS endpoint (το κατεβάζει ο API server):
OIDC_JWKS_URI=https://sso.trifylli.gr/application/o/trifylli/jwks/
OIDC_AUDIENCE=trifylli-pwa
# Ο πρώτος που θα συνδεθεί με αυτό το email γίνεται υπερδιαχειριστής:
SUPER_ADMIN_EMAIL=admin@trifylli.gr

# Build-time για την PWA (μπαίνουν στο bundle — rebuild αν αλλάξουν):
VITE_API_URL=https://api.trifylli.gr/api
VITE_OIDC_AUTHORITY=https://sso.trifylli.gr/application/o/trifylli/
VITE_OIDC_CLIENT_ID=trifylli-pwa
# URL του OuchTracker (deep-links φαρμακείων) — ο υποτομέας του OuchTracker:
VITE_OUCHTRACKER_URL=https://ouch.trifylli.gr

# ─────────────────── Προαιρετικά (έχουν defaults) ───────────────────
# Πού δένονται οι θύρες στον host· 127.0.0.1 = μόνο ο τοπικός reverse proxy.
BIND_ADDR=127.0.0.1
API_PORT=3000
WEB_PORT=8080
AUTHENTIK_PORT=9010
TAG=latest
POSTGRES_USER=trifylli
POSTGRES_DB=trifylli
AUTHENTIK_DB=authentik
OUCHTRACKER_DB=ouchtracker
OUCHTRACKER_WEB_PORT=8081
S3_BUCKET=trifylli
S3_REGION=garage
GARAGE_ADMIN_TOKEN=

# Αρχικός διαχειριστής Authentik (μόνο στο πρώτο boot· διαφορετικό email από τον
# SUPER_ADMIN_EMAIL, αλλιώς η σύνδεση με email γίνεται αμφίσημη):
AUTHENTIK_BOOTSTRAP_EMAIL=
AUTHENTIK_BOOTSTRAP_PASSWORD=

# ─────────────────── Ενσωματώσεις (προαιρετικά) ───────────────────
ESEO_BASE_URL=https://eseo.seo.gr/app/eseo
ESEO_REALM=eseo
ESEO_CLIENT_ID=ssoClient
ESEO_REFRESH_TOKEN=
ESEO_WEBHOOK_SECRET=
SYNC_ENABLED=true
OUCHTRACKER_BASE_URL=
OUCHTRACKER_EMAIL=
OUCHTRACKER_PASSWORD=

# ─────────────────── OuchTracker (φαρμακεία — ίδια στοίβα) ───────────────────
# Το Trifylli API μιλά στο OuchTracker εσωτερικά· default = http://ouchtracker-backend:3000.
# Λογαριασμός admin του OuchTracker που χρησιμοποιεί το Trifylli για τον δανεισμό
# (ανάθεση kit). Πρέπει να υπάρχει — είναι ο seeded admin παρακάτω:
OUCHTRACKER_EMAIL=admin@ouchtracker.local
OUCHTRACKER_PASSWORD=
# Το OuchTracker backend:
OUCHTRACKER_CORS_ORIGIN=https://ouch.trifylli.gr
OUCHTRACKER_JWT_SECRET=      # openssl rand -base64 48
OUCHTRACKER_SEED_ADMIN_EMAIL=admin@ouchtracker.local
OUCHTRACKER_SEED_ADMIN_PASSWORD=   # ίδιος με OUCHTRACKER_PASSWORD
# Single sign-on (ίδιο Authentik): ο issuer του 2ου OIDC app (slug `ouchtracker`).
OUCHTRACKER_OIDC_ISSUER=https://sso.trifylli.gr/application/o/ouchtracker/
OUCHTRACKER_OIDC_AUDIENCE=ouchtracker
OUCHTRACKER_OIDC_CLIENT_ID=ouchtracker
# Εσωτερικό JWKS (default σωστό)· άλλαξέ το μόνο αν αλλάξει το slug:
# OUCHTRACKER_OIDC_JWKS_URI=http://authentik-server:9000/application/o/ouchtracker/jwks/
# Emails που γίνονται ADMIN στο OuchTracker (comma-separated):
OUCHTRACKER_OIDC_ADMIN_EMAILS=admin@trifylli.gr

# ─────────────────── Υποτομείς (reverse proxy) ───────────────────
# Ένα domain, υποτομείς μπροστά από τη στοίβα (TLS από τον proxy σου):
#   app.trifylli.gr   → web            (:${WEB_PORT})
#   api.trifylli.gr   → api            (:${API_PORT})
#   sso.trifylli.gr   → authentik      (:${AUTHENTIK_PORT})
#   ouch.trifylli.gr  → ouchtracker    (:${OUCHTRACKER_WEB_PORT})  — κάνει μόνο του proxy /api
