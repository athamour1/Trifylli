# Παραγωγικές ρυθμίσεις Trifylli — αντίγραψε σε .env.prod και συμπλήρωσε.
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d --build
#
# Το .env.prod ΔΕΝ μπαίνει στο git (βλ. .gitignore). Μην το μοιράζεσαι.

# ─────────────────── ΥΠΟΧΡΕΩΤΙΚΑ μυστικά ───────────────────
# Βάση δεδομένων (χρησιμοποιείται από API και Authentik):
POSTGRES_PASSWORD=            # openssl rand -base64 32
REDIS_PASSWORD=              # openssl rand -base64 32
# Κλειδί κρυπτογράφησης του Authentik:
AUTHENTIK_SECRET_KEY=        # openssl rand -base64 48
# Αποθήκευση αρχείων (Garage S3 — αποδείξεις ταμείου, εικόνες markdown):
GARAGE_RPC_SECRET=           # openssl rand -hex 32
# Μορφή που δέχεται το Garage: key = «GK» + 24 hex, secret = 64 hex.
S3_ACCESS_KEY_ID=            # GK + openssl rand -hex 12
S3_SECRET_ACCESS_KEY=        # openssl rand -hex 32

# ─────────────────── Δημόσια URLs (του reverse proxy) ───────────────────
# Αντικατέστησε τα example domains με τα δικά σου. Πρέπει να είναι ΑΚΡΙΒΩΣ ό,τι
# βλέπει ο browser (μέσω του proxy σου με TLS).
#
# Το origin της PWA — για το CORS του API:
CORS_ORIGINS=https://app.trifylli.gr
# Ο OIDC issuer: πρέπει να ταιριάζει ΑΚΡΙΒΩΣ με το `iss` του token του Authentik.
OIDC_ISSUER=https://sso.trifylli.gr/application/o/trifylli/
# Το JWKS endpoint (το κατεβάζει ο API server):
OIDC_JWKS_URI=https://sso.trifylli.gr/application/o/trifylli/jwks/
OIDC_AUDIENCE=trifylli-pwa
# Ο πρώτος που θα συνδεθεί με αυτό το email γίνεται υπερδιαχειριστής:
SUPER_ADMIN_EMAIL=admin@trifylli.gr

# ── Το Τοπικό (πρώτο στήσιμο) ──
# Στο πρώτο `up` το `migrate` φτιάχνει το Τοπικό, τους τέσσερις κλάδους και την
# τρέχουσα οδηγική χρονιά — μόνο αν η βάση δεν έχει ήδη Τοπικό. Τα μέλη έρχονται
# μετά από τον συγχρονισμό με το e-SEO.
TOPIKO_NAME=Τοπικό Τμήμα
TOPIKO_LOCATION=
# Ο κωδικός μονάδας του Τοπικού στο e-SEO (προαιρετικό).
TOPIKO_ESEO_CODE=
# Η ετήσια συνδρομή της πρώτης οδηγικής χρονιάς (€) — αλλάζει μετά από την εφαρμογή.
SYNDROMI_AMOUNT=60

# Runtime config της PWA (ο entrypoint τα γράφει στο /config.js — ΑΛΛΑΓΗ = restart,
# όχι rebuild):
VITE_API_URL=https://api.trifylli.gr/api
VITE_OIDC_AUTHORITY=https://sso.trifylli.gr/application/o/trifylli/
VITE_OIDC_CLIENT_ID=trifylli-pwa
# URL του OuchTracker (deep-links φαρμακείων) — ο υποτομέας του OuchTracker:
VITE_OUCHTRACKER_URL=https://ouch.trifylli.gr

# Δημόσια URLs των εφαρμογών (με τελικό «/») — τα διαβάζουν τα Authentik blueprints
# για redirect URIs, launch URL και **Single Logout** (front-channel logout URI).
# ΥΠΟΧΡΕΩΤΙΚΑ στο prod. ΠΡΕΠΕΙ να είναι υποτομείς του ΙΔΙΟΥ domain με το Authentik
# (app./ouch./sso.<domain>) — αλλιώς ο browser διαχωρίζει το storage του κρυφού
# logout-iframe και το SLO δεν διαδίδεται. Ο reverse proxy να ΜΗΝ στέλνει
# `X-Frame-Options: DENY` στο /auth/frontchannel-logout (το φορτώνει ο Authentik
# σε iframe)· αν βάζεις CSP, επίτρεψε `frame-ancestors` τον υποτομέα του Authentik.
TRIFYLLI_APP_URL=https://app.trifylli.gr/
OUCHTRACKER_APP_URL=https://ouch.trifylli.gr/

# ─────────────────── Προαιρετικά (έχουν defaults) ───────────────────
# Πού δένονται οι θύρες στον host· 127.0.0.1 = μόνο ο τοπικός reverse proxy.
# Proxy σε Docker (Zoraxy, NPM, Traefik); ΟΧΙ την IP του LAN εδώ — σύνδεσέ τον στο
# δίκτυο `trifylli-public` (βλ. «Υποτομείς» στο τέλος). Αλλιώς κάθε συσκευή του
# δικτύου φτάνει API και SSO κατευθείαν, χωρίς TLS.
BIND_ADDR=127.0.0.1
API_PORT=3000
WEB_PORT=8080
AUTHENTIK_PORT=9010
# Εκδόσεις images από το GHCR (τις σπρώχνει το ./release.sh κάθε project).
# Το TAG είναι ΥΠΟΧΡΕΩΤΙΚΟ (π.χ. v1.0.3): με `latest` ένα `pull` φέρνει ό,τι βγήκε
# τελευταίο, και για rollback πρέπει να θυμάσαι ποια ήταν η προηγούμενη. Το
# gen-env το συμπληρώνει με την έκδοση του config image· για αναβάθμιση το αλλάζεις.
TAG=
OUCHTRACKER_TAG=latest
POSTGRES_USER=trifylli
POSTGRES_DB=trifylli
AUTHENTIK_DB=authentik
OUCHTRACKER_DB=ouchtracker
OUCHTRACKER_WEB_PORT=8081
S3_BUCKET=trifylli
S3_REGION=garage
GARAGE_ADMIN_TOKEN=

# Αρχικός διαχειριστής Authentik (μόνο στο πρώτο boot· διαφορετικό email από τον
# SUPER_ADMIN_EMAIL, αλλιώς η σύνδεση με email γίνεται αμφίσημη):
AUTHENTIK_BOOTSTRAP_EMAIL=akadmin@trifylli.gr
AUTHENTIK_BOOTSTRAP_PASSWORD=   # openssl rand -base64 24

# ─────────────────── Authentik: service account του API (ΥΠΟΧΡΕΩΤΙΚΟ) ───────────────────
# Το κλειδί του token με το οποίο το API στέλνει «σύνδεσμο ορισμού κωδικού». ΔΕΝ
# φτιάχνεται στο admin UI: το blueprint trifylli-security.yaml δημιουργεί το
# service account `trifylli-api` με ΜΟΝΟ τα δικαιώματα που χρειάζεται και του
# δίνει αυτό ακριβώς το κλειδί. Περιστροφή = νέα τιμή εδώ + restart.
AUTHENTIK_API_TOKEN=          # openssl rand -hex 32
# Το εσωτερικό URL μέσα στη στοίβα· άλλαξέ το μόνο αν αλλάξει το όνομα υπηρεσίας:
# AUTHENTIK_API_URL=http://authentik-server:9000

# ─────────────────── Ασφάλεια σύνδεσης & API ───────────────────
# MFA: `configure` = όποιος χρήστης δεν έχει authenticator στήνει TOTP (εφαρμογή
# κινητού) στην πρώτη σύνδεση. `skip` απενεργοποιεί — μόνο συνειδητά.
AUTHENTIK_MFA_MODE=configure
# Πόσοι reverse proxies μπροστά από το API (για σωστή IP πελάτη στο rate limiting).
# 1 = ο Caddy/Traefik/nginx σου. Ποτέ `0` σε παραγωγή: όλοι θα μοιράζονταν ένα όριο.
TRUST_PROXY_HOPS=1
# Swagger (/api/docs) στην παραγωγή: κλειστό. `true` μόνο προσωρινά, για debugging.
SWAGGER_ENABLED=false
# Τα subnets των δύο δικτύων της στοίβας. Τα εμπιστεύεται το Authentik για το
# X-Forwarded-For (brute force ανά IP) — από εκεί έρχεται ο proxy. Άλλαξέ τα μόνο
# αν συγκρούονται με άλλο δίκτυο του host.
STACK_SUBNET=10.97.50.0/24
PUBLIC_SUBNET=10.97.51.0/24
# Proxy σε ΑΛΛΟ μηχάνημα: πρόσθεσε την IP του — ποτέ ολόκληρο το LAN.
# AUTHENTIK_TRUSTED_PROXY_CIDRS=127.0.0.0/8,10.97.50.0/24,10.97.51.0/24,192.168.1.10/32

# ─────────────────── Αντίγραφα ασφαλείας ───────────────────
# Καθημερινό pg_dump στο volume `postgres-backups` (service `backup`). Συγχρόνισε
# το volume εκτός διακομιστή — αυτό εδώ δεν σώζει από χαμένο δίσκο.
# Κανένα αντίγραφο πάνω από 30 ημέρες: η φόρμα υγείας λέει στους γονείς ότι τα
# ιατρικά φεύγουν και από τα αντίγραφα μέσα σε 30 ημέρες. Αν τα αλλάξεις, άλλαξε
# και το BACKUP_RETENTION_DAYS (packages/shared) — αλλιώς η φόρμα λέει ψέματα.
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=14
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=0
# Dumps πριν από κάθε migration (service `predeploy-backup`).
PREDEPLOY_KEEP_DAYS=30

# ─────────────────── Αντίγραφα ΕΚΤΟΣ server (restic) ───────────────────
# Τα dumps + τα αρχεία του Garage, κρυπτογραφημένα, μία φορά τη μέρα (service
# `backup-offsite`). Χωρίς προορισμό η στοίβα σηκώνεται, αλλά το `backup-offsite`
# μένει «unhealthy» και γράφει προειδοποίηση κάθε μέρα. Παραδείγματα:
#   Backblaze B2 (ΕΕ, μέσω S3):  s3:https://s3.eu-central-003.backblazeb2.com/<bucket>/trifylli
#                                (+ RESTIC_AWS_ACCESS_KEY_ID / RESTIC_AWS_SECRET_ACCESS_KEY)
#   Hetzner Storage Box (SFTP):  sftp://u123456@u123456.your-storagebox.de:23/trifylli
#                                (+ RESTIC_SSH_KEY_B64)
#   NAS (SFTP):                  sftp://backup@nas.example.gr//srv/trifylli
#                                (+ RESTIC_SSH_KEY_B64)
RESTIC_REPOSITORY=
# Ο κωδικός κρυπτογράφησης. ΧΩΡΙΣ αυτόν τα αντίγραφα δεν ανοίγουν ποτέ: κράτα τον
# (και όλο το .env.prod) σε password manager, εκτός server.
RESTIC_PASSWORD=             # openssl rand -base64 32
RESTIC_AWS_ACCESS_KEY_ID=
RESTIC_AWS_SECRET_ACCESS_KEY=
# Ιδιωτικό κλειδί SSH για SFTP, σε base64 μίας γραμμής: base64 -w0 < id_ed25519
RESTIC_SSH_KEY_B64=

# ─────────────────── SMTP (ανάκτηση κωδικού) ───────────────────
# ΥΠΟΧΡΕΩΤΙΚΑ: SMTP_HOST και SMTP_FROM. Χωρίς αυτά η στοίβα δεν σηκώνεται —
# σκόπιμα, γιατί η εναλλακτική είναι να το ανακαλύψεις τη μέρα που κάποιος
# ξεχάσει τον κωδικό του. Στο development τη θέση τους παίρνει το Mailpit
# (docker-compose.yml — web UI στο http://localhost:8025).
SMTP_HOST=smtp.eu.mailgun.org
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# 587 → STARTTLS: SMTP_USE_TLS=true. 465 → implicit TLS: SMTP_USE_SSL=true και
# SMTP_USE_TLS=false. Ποτέ και τα δύο true.
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=30
# Ο αποστολέας — σε domain με SPF/DKIM στον πάροχο, αλλιώς πάει για spam:
SMTP_FROM=Trifylli <noreply@trifylli.gr>

# ─────────────────── Ενσωματώσεις (προαιρετικά) ───────────────────
ESEO_BASE_URL=https://eseo.seo.gr/app/eseo
ESEO_REALM=eseo
ESEO_CLIENT_ID=ssoClient
ESEO_REFRESH_TOKEN=
ESEO_WEBHOOK_SECRET=
SYNC_ENABLED=true

# ─────────────────── OuchTracker (φαρμακεία — ίδια στοίβα) ───────────────────
# Το Trifylli API μιλά στο OuchTracker εσωτερικά· default = http://ouchtracker-backend:3000.
# Λογαριασμός admin του OuchTracker που χρησιμοποιεί το Trifylli για τον δανεισμό
# (ανάθεση kit). Πρέπει να υπάρχει — είναι ο seeded admin παρακάτω:
OUCHTRACKER_EMAIL=admin@ouchtracker.local
OUCHTRACKER_PASSWORD=
# Το OuchTracker backend:
OUCHTRACKER_CORS_ORIGIN=https://ouch.trifylli.gr
OUCHTRACKER_JWT_SECRET=      # openssl rand -base64 48
OUCHTRACKER_SEED_ADMIN_EMAIL=admin@ouchtracker.local
OUCHTRACKER_SEED_ADMIN_PASSWORD=   # ίδιος με OUCHTRACKER_PASSWORD
# Single sign-on (ίδιο Authentik): ο issuer του 2ου OIDC app (slug `ouchtracker`).
OUCHTRACKER_OIDC_ISSUER=https://sso.trifylli.gr/application/o/ouchtracker/
OUCHTRACKER_OIDC_AUDIENCE=ouchtracker
OUCHTRACKER_OIDC_CLIENT_ID=ouchtracker
# Εσωτερικό JWKS (default σωστό)· άλλαξέ το μόνο αν αλλάξει το slug:
# OUCHTRACKER_OIDC_JWKS_URI=http://authentik-server:9000/application/o/ouchtracker/jwks/
# Emails που γίνονται ADMIN στο OuchTracker (comma-separated):
OUCHTRACKER_OIDC_ADMIN_EMAILS=admin@trifylli.gr

# ─────────────────── Υποτομείς (reverse proxy) ───────────────────
# Ένα domain, υποτομείς μπροστά από τη στοίβα (TLS από τον proxy σου).
# Proxy στον host → 127.0.0.1:<θύρα>.  Proxy σε Docker → μία φορά
#   docker network connect trifylli-public <container του proxy>
# και ως στόχους τα ονόματα (χωρίς θύρες στον host):
#   app.trifylli.gr   → trifylli-web:80     ή 127.0.0.1:${WEB_PORT}
#   api.trifylli.gr   → trifylli-api:3000   ή 127.0.0.1:${API_PORT}
#   sso.trifylli.gr   → trifylli-sso:9000   ή 127.0.0.1:${AUTHENTIK_PORT}
#   ouch.trifylli.gr  → trifylli-ouch:80    ή 127.0.0.1:${OUCHTRACKER_WEB_PORT}  — κάνει μόνο του proxy /api
